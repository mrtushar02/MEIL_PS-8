PROJECT_NAME="MEIL ESG / BRSR Enterprise Platform"
API_V1_STR="/api/v1"
SECRET_KEY="meil-super-secret-key-change-in-production-esg-platform"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite default (for offline dev):
# DATABASE_URL="sqlite:///./meil_esg.db"
#
# Supabase PostgreSQL (Cloud Database):
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Mode 1: Direct Connection (Session Mode):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Mode 2: Transaction Pooler (Recommended on IPv4 networks or serverless):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DATABASE_URL="sqlite:///./meil_esg.db"

# Supabase Storage & API Keys (Found in: Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_KEY="your-service-role-secret-key"

# Redis Configuration (Optional Fast Processing / Cache)
REDIS_URL="redis://localhost:6379/0"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
